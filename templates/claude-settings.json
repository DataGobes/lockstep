{
  "permissions": {
    "allow": ["Bash(uv run pytest*)", "Bash(dbt build*)", "Bash(dbt test*)", "Bash(databricks bundle validate*)"],
    "ask": ["Bash(git push*)", "Bash(databricks bundle deploy*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./data/samples/**)",
      "Bash(databricks bundle deploy -t prod*)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.lockstep/hooks/run-hook.sh\" protect_tests" },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.lockstep/hooks/run-hook.sh\" team_rules" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.lockstep/hooks/run-hook.sh\" guard_bash" },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.lockstep/hooks/run-hook.sh\" team_rules" }
        ]
      }
    ]
  }
}
